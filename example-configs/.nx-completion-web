# .nx-completion for apps/web/
#
# AUTO-DETECT ACTIVATION:
# Just creating this file enables enhanced completion features!
# No environment variables needed - the plugin automatically detects
# .nx-completion files and activates enhanced mode.
#
# Drop this file in apps/web/ to prioritize web projects

# Prioritize web projects
NX_PRIORITY_TAGS="scope:web,type:app,audience:retail,audience:internal"

# Deprioritize mobile and test utilities
NX_DEPRIORITIZE_TAGS="scope:mobile,type:test-lib"

# Boost for web context
NX_FOLDER_BOOST="200"
